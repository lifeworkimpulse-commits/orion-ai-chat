{
  "name": "orion-supplies/orion-ai-assistant",
  "description": "AI shopping assistant for WooCommerce powered by OpenRouter.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": { "php": ">=8.0" },
  "require-dev": {
    "phpstan/phpstan": "^1.12",
    "szepeviktor/phpstan-wordpress": "^1.3",
    "squizlabs/php_codesniffer": "^3.10",
    "wp-coding-standards/wpcs": "^3.1",
    "phpunit/phpunit": "^9.6"
  },
  "scripts": {
    "lint": "phpcs --standard=phpcs.xml.dist",
    "analyse": "phpstan analyse --configuration=phpstan.neon.dist",
    "test": "phpunit"
  },
  "config": { "allow-plugins": { "dealerdirect/phpcodesniffer-composer-installer": true } }
}
